      {
        "triplet_index": 0,
        "chu_han": "三卿其寵大矣",
        "phien_am": "tam khanh, kỳ sủng đại hì",
        "dich_nghia_gloss": "ba làm quan khanh, vua yêu đã cực vậy"
      },
      {
        "triplet_index": 1,
        "chu_han": "一朝而滅莫之哀也",
        "phien_am": "Nhất triêu nhi diệt, mạc chi ai dã",
        "dich_nghia_gloss": "một sớm diệt vong, không ai thương"
      },
      {
        "triplet_index": 2,
        "chu_han": "唯無德也",
        "phien_am": "duy vô đức dã.",
        "dich_nghia_gloss": "chỉ vì không có đức vậy"
      },
      {
        "triplet_index": 3,
        "chu_han": "今吾子有欒武子之貧",
        "phien_am": "Kim ngô tử hữu Loan-vũ-tử chi bần",
        "dich_nghia_gloss": "Nay bác nghèo như Loan-vũ-tử"
      },
      {
        "triplet_index": 4,
        "chu_han": "吾以爲能其德矣是以賀",
        "phien_am": "ngô dĩ vi năng kỳ đức hĩ, thị dĩ hạ.",
        "dich_nghia_gloss": "nhưng cái đức cũng sánh Loan-vũ-tử, nên chúc mừng"
      },
      {
        "triplet_index": 5,
        "chu_han": "若不憂德之不建",
        "phien_am": "Nhược bất ưu đức chi bất kiên",
        "dich_nghia_gloss": "Nêu không lo sửa đức"
      },
      {
        "triplet_index": 6,
        "chu_han": "而患貨之不足",
        "phien_am": "nhi hoạn hóa chi bắt túc,",
        "dich_nghia_gloss": "chỉ sợ của cải không đủ"
      },
      {
        "triplet_index": 7,
        "chu_han": "將弔不暇何賀之有",
        "phien_am": "tương điều bất hạ, hà hạ chi hữu?",
        "dich_nghia_gloss": "thì phải chia buồn, chứ có gì mà mừng"
