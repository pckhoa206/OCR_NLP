        "triplet_index": 0,
        "chu_han": "召公曰是障之也",
        "phien_am": "Thiệu-công viết: thị chướng chi dã.",
        "dich_nghia_gloss": "Chiêu-công nói: ây là che lập vậy thôi"
      },
      {
        "triplet_index": 1,
        "chu_han": "防民之口甚於防川",
        "phien_am": "Phòng dân chi khầu thậm ư phòng xuyên",
        "dich_nghia_gloss": "ngừa miệng dân cũng như ngừa sông"
      },
      {
        "triplet_index": 2,
        "chu_han": "川壅而潰傷人必多",
        "phien_am": "Xuyên úng nhi hội thương nhân tất da.",
        "dich_nghia_gloss": "Sông úng võ đê thì hại rất nhiều"
      },
      {
        "triplet_index": 3,
        "chu_han": "民亦如之",
        "phien_am": "Dân diệc như chi.",
        "dich_nghia_gloss": "Dân cũng như sông vậy"
      },
      {
        "triplet_index": 4,
        "chu_han": "是故爲川者决之使導",
        "phien_am": "Thị cõ vị xuyên giả quyết chi xử đạo",
        "dich_nghia_gloss": "Cho nên vì sông, thì phải khơi dòng"
      },
      {
        "triplet_index": 5,
        "chu_han": "爲民者宣之使言",
        "phien_am": "Vị dân giả tuyên chi xử ngôn",
        "dich_nghia_gloss": "vì dân phải lầy lời mà tỏ ra vì dân, cho tự đáy lòng nói ra,"
      },
      {
        "triplet_index": 6,
        "chu_han": "故天子聽政",
        "phien_am": "Cõ thiên-tử thính chính,",
        "dich_nghia_gloss": "nên vua ngồi cai trị"
      },
      {
        "triplet_index": 7,
