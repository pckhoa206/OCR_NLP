      {
        "triplet_index": 0,
        "chu_han": "北宮之女嬰兒子無恙耶",
        "phien_am": "Bắc-cung chi nữ Anh-nhi-tử vô dạng da ?",
        "dich_nghia_gloss": "Nàng Anh-nhi họ Bắc-cung bình yên chứ ?"
      },
      {
        "triplet_index": 1,
        "chu_han": "徹其環瑱至老不嫁",
        "phien_am": "Triệt kỳ hoàn thiên, chi lão bãt giá",
        "dich_nghia_gloss": "Bỏ cả vòng, bông tai, đên già không lầy chồng"
      },
      {
        "triplet_index": 2,
        "chu_han": "以養父母是其率民",
        "phien_am": "dĩ dưỡng phụ mẫu: thị kỳ suất dân",
        "dich_nghia_gloss": "để nuôi cha mẹ: ây là làm gương"
      },
      {
        "triplet_index": 3,
        "chu_han": "而出於孝情者也",
        "phien_am": "nhi xuất ư hiễu-tình giả dã",
        "dich_nghia_gloss": "hiều cho dân"
      },
      {
        "triplet_index": 4,
        "chu_han": "胡爲至今不朝也",
        "phien_am": "hồ vi chí kim bắt triều dã ?",
        "dich_nghia_gloss": "sao bây giờ chưa được tặng phong"
      },
      {
        "triplet_index": 5,
        "chu_han": "此二士弗業一女不朝",
        "phien_am": "Thử nhị sĩ phát nghiệp, nhất nữ bãt triều",
        "dich_nghia_gloss": "Hai kẻ sĩ không có chức, một gái không được phong"
      },
      {
        "triplet_index": 6,
        "chu_han": "何以王齊國子萬民乎",
        "phien_am": "hà di vượng Tê-quốc, tử vạn dân hồ ?",
        "dich_nghia_gloss": "lây gì cho nước Tề thịnh, cứu muôn dân ?"
      },
      {
        "triplet_index": 7,
        "chu_han": "於陵子仲尚存乎",
        "phien_am": "Ô Lăng Tử Trọng thượng tón hồ ?",
        "dich_nghia_gloss": "Ô-Lăng Tử Trọng còn chăng"
