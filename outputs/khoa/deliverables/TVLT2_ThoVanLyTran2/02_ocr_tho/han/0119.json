    "chu_han_lines": [
      "颂",
      "持之則軟扭之柔",
      "鐵額銅頭進莫由",
      "雖是虛空無間隙",
      "夜来依盖桂華秋。",
      "舉",
      "龎居士云。此是送佛塲。心空及第歸。",
      "招",
      "鴈塔趣名。不容曳白。",
      "颂",
      "鶉衣百結草鞋穿",
      "選佛塲中奪桂箋",
      "若謂心空來應舉",
      "不遭鞭撻也遭拳。",
      "舉",
      "慈明問真點胸佛法大意。",
      "真曰。無雲生嶺上",
      "有月落波心。",
      "明喝曰。頭白齒黄。猶作此見解。真淚下。",
      "光曰。不知如何是佛法大意。",
      "明曰。無雲生嶺上",
      "有月落波心。",
      "真大悟。",
      "指",
      "仁者見之謂之仁",
      "智者見之謂之智。",
      "公",
      "彼此同鳴一調琴",
      "須當分付與知音",
      "無雲有月雖同是",
      "羊奈山高與水深。",
      "咄",
      "終日走紅塵。不識自家珍。",
      "夷",
      "撒手無依全體現",
      "扁舟漁父宿蘆華。"
    ],
