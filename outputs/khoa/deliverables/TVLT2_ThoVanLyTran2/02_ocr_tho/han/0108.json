  "layout_summary": {
    "layout_mode": "sequential_prose",
    "chu_han_lines": [
      "争似一枝無孔笛",
      "為君吹起太平歌。",
      "舉",
      "罽賓國王秉劍謂二十四祖尊者云。師得蘊空",
      "否。曰已得。曰離生死否。日已离。曰可施我頭否。曰",
      "身非我有。沉於頭乎。王便斬。白乳涌出。王臂自墮",
      "招",
      "將頭臨白刃",
      "猶如斬春風。",
      "公颂",
      "利刀斷水火吹光",
      "那事應知也不妨",
      "報道今朝遠煙浪",
      "誰知别有好思量。",
      "舉",
      "逹麽大師至洛陽少林。九年面壁而坐。",
      "招",
      "著眼看休瞌睡。",
      "颂",
      "鵬摶一奮到南溟",
      "接踵徒劳萬里程",
      "昨夜紙貪筵上樂",
      "今朝不覺醉難醒。",
      "舉",
      "二祖乞達麼安心。麽曰。將心來與汝安。曰觅心",
      "了不可得，麽曰。安心竟。",
      "招",
      "三歲孩兜抱華鼓",
      "八十老翁衣繡毬",
      "颂",
      "心無心道向誰",
      "夢回啞子眼麻彌",
      "老僧謾道能安竟",
      "笑殺傍觀不自知。"
    ],
    "interlinear_triplets": []
  }
