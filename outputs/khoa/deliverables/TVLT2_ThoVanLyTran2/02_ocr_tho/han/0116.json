  "layout_summary": {
    "layout_mode": "sequential_prose",
    "chu_han_lines": [
      "兩條利刃休粘密",
      "異日免童口内傷",
      "舉",
      "南泉見鄧隐峯來指淨瓶云。浄瓶是境倆不得",
      "動著境。",
      "招",
      "說有向什麼處著。",
      "公颂",
      "鏡中無垢自徒麿",
      "費盡工夫不奈何",
      "默默休休隨處樂",
      "當特飯後一杯茶。",
      "舉",
      "石頭云。恁麼也不得。不恁麼也不得恁麼不恁",
      "麼總不得。",
      "指",
      "諸行無常",
      "一切背苦。",
      "公頌",
      "好箇話端將似汝",
      "暫為谷口白雲橫",
      "縱饒全得十分舉",
      "猶在途中萬里程",
      "举",
      "僧問如何是岚山境。",
      "山云猿抱子歸青嶂後。",
      "鳥啣華，落碧巖前。",
      "拈",
      "干木隨身。逢塲作戲。",
      "公颂",
      "炭山幽境無人到",
      "直下應當作麼生",
      "若是勝流真具眼",
      "任教日午鼓三更。"
    ],
    "interlinear_triplets": []
  }
