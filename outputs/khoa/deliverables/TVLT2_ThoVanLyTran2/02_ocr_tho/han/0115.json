  "layout_summary": {
    "layout_mode": "sequential_prose",
    "chu_han_lines": [
      "等閑打草要蛇驚",
      "若人慣涉長安路",
      "措手何須苦問程。",
      "举",
      "玄沙示眾云諸方老宿盡道接物利生。忽遇三",
      "種病人來。如何接，患育者。指槌整佛他又不见。",
      "患聾者語言三昧他又不聞。患癌者教伊說又",
      "說不得。",
      "粘",
      "渴飲饑飧",
      "寒衣熟扇。",
      "頌",
      "憂之戚減樂熙熙",
      "鼻直眉横不異知",
      "饑渴熱寒隨處得",
      "何须特地却生疑。",
      "舉",
      "瑞巖常喚主人翁惺惺者。向後莫被人欺。",
      "拈",
      "啼得血流無用處",
      "不如緘口度殘春",
      "公颂",
      "瑞薇常喚主人公",
      "莫略沉機亦水雄",
      "若是世間無敵將",
      "爭教技擊日為隆。",
      "舉",
      "三聖云。我逢人郎出。出則不為人。與仁之我途",
      "人则不出出則便為人。",
      "扎",
      "一箇盲龜",
      "牛雙跛",
      "公",
      "逢渴之時便飲漿",
      "終朝說食不充腸"
    ],
    "interlinear_triplets": []
  }
