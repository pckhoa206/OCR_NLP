    "chu_han_lines": [
      "举",
      "趙州云。我在青州作一顾市衫重七斤。",
      "占",
      "鎮州蘿蔔猶自可",
      "青州市衫更愁人。",
      "公颂",
      "一領布衫特異常",
      "趙州篋笥不包藏",
      "箇中擬議分銖兩",
      "笑殺東家孟八郎。",
      "舉",
      "僧問趙州。狗子有佛性也無州云無。又問。州云",
      "有。",
      "拈",
      "雨采一賽。",
      "頌",
      "問著當前對有無",
      "直教言下滅群胡",
      "一生自負莫靈漢",
      "也是猶為不丈夫。",
      "舉",
      "趙州有佛處不得住。無佛處急走遇。",
      "指",
      "水到渠成",
      "棒捶痕現。",
      "公颂",
      "有無佛處两俱捐",
      "這語都來未是全",
      "末後楊華还舉似",
      "不離寸步到西天。",
      "舉",
      "首山拈竹篦。云。唤作竹篦郎觸。不唤作竹篦卽",
      "背。且喚作什麼。",
      "占",
      "勿動著動著三十棒。"
    ],
    "interlinear_triplets": []
  }
