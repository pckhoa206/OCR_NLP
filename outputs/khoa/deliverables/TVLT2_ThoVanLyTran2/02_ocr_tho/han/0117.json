    "chu_han_lines": [
      "舉",
      "僧問睦州。一氣还轉得一大藏經也無州云有",
      "甚驛鑼鎚子快下將來",
      "花",
      "撒手到家",
      "不劳進步。",
      "公颂",
      "一氣自能回一藏",
      "不劳摘葉與時枝",
      "無邊玄義昭然現",
      "問著山僧總不知。",
      "舉",
      "臨濟會中两堂首座齊下喝。僧問。还有賓主也",
      "無。濟云。賓主歷然。",
      "招",
      "也是猴白亂說。",
      "公",
      "聖主當天鼓化風",
      "本图文範盡相同",
      "猶來遠近分疆里",
      "安得臨民濟世功。",
      "舉",
      "玄沙云。若論者事。喻似一片田地主，至界分契",
      "賣與諸人了也。私有中心树子。猶属老僧在。",
      "招",
      "大海不納死屍。",
      "公顷",
      "縱你明明悟了人",
      "心頭萬慮沒紜紛",
      "箇中尚有絲毫在",
      "入眼黃金却是塵",
      "舉",
      "僧問思和尚佛法大意，思云，盧陵米作麼價。"
    ],
    "interlinear_triplets": []
  }
