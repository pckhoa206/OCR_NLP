    "chu_han_lines": [
      "公頌",
      "達多初降洋王宫",
      "欲化群生自顕蹤",
      "七步周行指天地",
      "绒乡佛子表家風，",
      "舉",
      "世尊招華迦葉破顏微笑",
      "粘",
      "别起眉毛著眼者",
      "進前機議隔千山",
      "頌",
      "世尊兆起一阮華",
      "迦葉今朝得到家",
      "若謂此為傳法要",
      "北轅適越路應車。",
      "舉",
      "外道問佛。不問有言。不問無言。",
      "花",
      "除是我家真的子",
      "誰人敢向裏頭行",
      "颂",
      "牢開難繫有誰知",
      "言語都忘沒處依",
      "不是世中良焉子",
      "何由特地得便宜。",
      "舉",
      "世尊陞座文殊白槌云諦觀法王法法王法如",
      "是。",
      "招",
      "無絃琴上春陽春",
      "千古萬古聲不絕。",
      "頌",
      "雖言句句洗疵癥",
      "掛角應猶露尾巴"
    ],
